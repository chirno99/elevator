# MQTT Broker Settings
# config.py が読む名前は MQTT_HOST（MQTT_BROKER ではない）
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=elevator/status

# Device Settings
# 号機。E001=1, E002=2, E003=3。送信するのは 1〜99
DEVICE_ID=E003
CAMERA_ID=0

# Camera Settings
# 人数モデルは公式の YOLO 重み。階・矢印モデルは best.pt
YOLO_AI_MODEL_PASS=yolo26n.pt
ELEVATOR_AI_MODEL_PASS=best.pt
